<?xml version="1.0" encoding="utf-8"?>
<!-- The PC port for Android: a NativeActivity (no Java code), 32-bit ARM.
     targetSdk 28: reading the disc image from /sdcard with the permission to
     read files (the storage of apps targeting 28 is not scoped). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.olegazmaster.crash3port"
    android:versionCode="12"
    android:versionName="0.12">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:label="Crash 3 (порт)"
        android:hasCode="false"
        android:extractNativeLibs="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="crash3" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
